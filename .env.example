# ==============================================================================
# EATLEY - ARCHIVO DE EJEMPLO DE VARIABLES DE ENTORNO (.env.example)
#
# Copia este archivo como .env y coloca tus valores reales:
#   cp .env.example .env
#
# NOTA DE SEGURIDAD:
# El archivo .env está protegido en .gitignore y NUNCA debe subirse a Git.
# ==============================================================================

# Nombre de la aplicación y zona horaria
VITE_APP_NAME=eatley
VITE_APP_TIMEZONE=America/Guayaquil

# Credenciales de Firebase (Obtener desde Firebase Console > Configuración del Proyecto > General)
# Clave de API de Firebase Web
VITE_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
# Dominio de autenticación (ej: tu-proyecto.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_PROJECT_ID.firebaseapp.com
# URL de Realtime Database (ej: https://tu-proyecto-default-rtdb.firebaseio.com/)
VITE_FIREBASE_DATABASE_URL=https://REPLACE_WITH_PROJECT_ID-default-rtdb.firebaseio.com/
# ID del proyecto en Firebase
VITE_FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
# Bucket de almacenamiento
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_PROJECT_ID.firebasestorage.app
# ID del remitente de mensajería (Cloud Messaging Sender ID)
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_SENDER_ID
# ID único de la aplicación Web en Firebase
VITE_FIREBASE_APP_ID=REPLACE_WITH_APP_ID
# ID opcional de Google Analytics / Medición (ej: G-XXXXXXXXXX)
VITE_FIREBASE_MEASUREMENT_ID=REPLACE_WITH_MEASUREMENT_ID

# Nodo raíz en Firebase Realtime Database (aísla los datos del dispensador)
VITE_FIREBASE_ROOT_PATH=eatley_v1

# Umbral en segundos para considerar al ESP32 desconectado si no actualiza su heartbeat
VITE_ESP32_OFFLINE_THRESHOLD_SEC=45
